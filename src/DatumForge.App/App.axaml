<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DatumForge.App.App"
             xmlns:local="using:DatumForge.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="Background" Value="#0C1014" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#25313B" />
        </Style>
        <Style Selector="Button.ribbon-command">
            <Setter Property="Height" Value="62" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#DCE5EA" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ribbon-command:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#25313B" />
        </Style>
        <Style Selector="Button.ribbon-command:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4E40" />
        </Style>
        <Style Selector="Button.ribbon-command:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="TextBlock.ribbon-icon">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#D8E3E8" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.ribbon-command-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#D8E3E8" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.ribbon-group-label">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#71838F" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="LetterSpacing" Value="0.8" />
        </Style>
        <Style Selector="Button.title-action">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9D4DB" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.title-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A353E" />
        </Style>
        <Style Selector="Button.title-action:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Button.tab-close">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A4AD" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.tab-close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3A4650" />
            <Setter Property="Foreground" Value="#F1F6F8" />
        </Style>
        <Style Selector="Button.tab-close:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4E40" />
        </Style>
        <Style Selector="Button.module-action">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#AAB8C0" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.module-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2B3740" />
        </Style>
        <Style Selector="Button.module-action:disabled">
            <Setter Property="Opacity" Value="0.25" />
        </Style>
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#D7E0E5" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#313D46" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#27A879" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#141A20" />
            <Setter Property="BorderBrush" Value="#29323A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Application.Styles>
</Application>
