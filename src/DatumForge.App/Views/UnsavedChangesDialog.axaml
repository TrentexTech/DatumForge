<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DatumForge.App.Views.UnsavedChangesDialog"
        Title="Unsaved changes"
        Width="500"
        Height="245"
        MinWidth="440"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <Grid ColumnDefinitions="Auto,*">
            <Border Width="42" Height="42" CornerRadius="21" Background="#3B2B17" Margin="0,0,14,0">
                <TextBlock Text="!" FontSize="24" FontWeight="Bold" Foreground="#F4B95E"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="Save changes before closing?" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="DatumForge found work that has not been saved." Foreground="#AEBBC3" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#141A20" BorderBrush="#29323A" BorderThickness="1"
                CornerRadius="5" Padding="12" Margin="0,18,0,18">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Save" Classes="primary" Width="92" IsDefault="True" Click="Save_OnClick" />
            <Button Content="Discard" Width="92" Click="Discard_OnClick" />
            <Button Content="Cancel" Width="92" IsCancel="True" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
