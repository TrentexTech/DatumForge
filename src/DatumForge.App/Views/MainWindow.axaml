<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DatumForge.App.ViewModels"
        xmlns:controls="using:DatumForge.App.Controls"
        xmlns:persistence="using:DatumForge.Infrastructure.Persistence"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="DatumForge.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900" MinWidth="1024" MinHeight="680"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_OnKeyDown">

    <Grid RowDefinitions="36,*">
        <!-- Integrated title bar with native window-behavior roles. -->
        <Border Grid.Row="0"
                Background="#11171C"
                BorderBrush="#2A333B"
                BorderThickness="0,0,0,1"
                Padding="10,0,0,0"
                WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="9">
                    <Border Width="22" Height="22" CornerRadius="5" Background="#27A879">
                        <TextBlock Text="D" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding WindowTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#DCE5EA" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                    <Button Classes="title-action"
                            Click="Settings_OnClick"
                            ToolTip.Tip="Settings"
                            AutomationProperties.Name="Settings"
                            WindowDecorationProperties.ElementRole="User">
                        <Path Data="M3,6 H9 M15,6 H21 M12,3 V9 M3,12 H13 M19,12 H21 M16,9 V15 M3,18 H7 M13,18 H21 M10,15 V21"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.7"
                              StrokeLineCap="Round"
                              Stretch="Uniform" />
                    </Button>
                    <Border Width="1" Height="18" Background="#334049" Margin="4,0" />
                    <Button Classes="title-action"
                            Command="{Binding SaveCommand}"
                            ToolTip.Tip="{Binding SaveToolTip}"
                            AutomationProperties.Name="Save"
                            WindowDecorationProperties.ElementRole="User">
                        <Path Data="M4,3 H16 L21,8 V21 H4 Z M8,3 V9 H16 V3 M8,15 H17 V21"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.6"
                              Stretch="Uniform" />
                    </Button>
                    <Border Width="1" Height="18" Background="#334049" Margin="4,0" />
                    <Button Classes="title-action"
                            Command="{Binding UndoCommand}"
                            ToolTip.Tip="{Binding UndoToolTip}"
                            AutomationProperties.Name="Undo"
                            WindowDecorationProperties.ElementRole="User">
                        <Path Data="M9,6 L4,11 L9,16 M5,11 H13 C17.5,11 20,13.5 20,18"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.8"
                              StrokeLineCap="Round"
                              Stretch="Uniform" />
                    </Button>
                    <Button Classes="title-action"
                            Command="{Binding RedoCommand}"
                            ToolTip.Tip="{Binding RedoToolTip}"
                            AutomationProperties.Name="Redo"
                            WindowDecorationProperties.ElementRole="User">
                        <Path Data="M15,6 L20,11 L15,16 M19,11 H11 C6.5,11 4,13.5 4,18"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.8"
                              StrokeLineCap="Round"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Classes="caption"
                            Click="Minimize_OnClick"
                            ToolTip.Tip="Minimize"
                            AutomationProperties.Name="Minimize"
                            WindowDecorationProperties.ElementRole="MinimizeButton">
                        <Border Width="12"
                                Height="1"
                                Background="{Binding $parent[Button].Foreground}"
                                VerticalAlignment="Bottom" />
                    </Button>
                    <Button Classes="caption"
                            Click="MaximizeRestore_OnClick"
                            ToolTip.Tip="Maximize or restore"
                            AutomationProperties.Name="Maximize or restore"
                            WindowDecorationProperties.ElementRole="MaximizeButton">
                        <Path Data="M3,3 H13 V13 H3 Z"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.2"
                              Stretch="Uniform" />
                    </Button>
                    <Button Classes="caption close"
                            Click="Close_OnClick"
                            ToolTip.Tip="Close"
                            AutomationProperties.Name="Close"
                            WindowDecorationProperties.ElementRole="CloseButton">
                        <Path Data="M3,3 L13,13 M13,3 L3,13"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="1.3"
                              StrokeLineCap="Round"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <!-- Excel-inspired application ribbon -->
        <Border Grid.Row="0" Background="#11171C" BorderBrush="#2A333B" BorderThickness="0,0,0,1">
            <Grid RowDefinitions="31,86">
                <Border BorderBrush="#2A333B" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                        <Button Classes.active="{Binding IsFileRibbonTab}" Classes="ribbon-tab"
                                Content="FILE" Command="{Binding SelectRibbonTabCommand}" CommandParameter="File" />
                        <Button Classes.active="{Binding IsInsertRibbonTab}" Classes="ribbon-tab"
                                Content="INSERT" Command="{Binding SelectRibbonTabCommand}" CommandParameter="Insert" />
                        <Button Classes.active="{Binding IsModifyRibbonTab}" Classes="ribbon-tab"
                                Content="MODIFY" Command="{Binding SelectRibbonTabCommand}" CommandParameter="Modify" />
                        <Button Classes.active="{Binding IsViewRibbonTab}" Classes="ribbon-tab"
                                Content="VIEW" Command="{Binding SelectRibbonTabCommand}" CommandParameter="View" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" IsVisible="{Binding IsFileRibbonTab}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="#303A43" BorderThickness="0,0,1,0" Padding="6,3,7,0">
                            <Grid RowDefinitions="*,18">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="ribbon-command" Width="58" Click="NewProject_OnClick" ToolTip.Tip="Create a new project" AutomationProperties.Name="New project">
                                        <StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="＋" /><TextBlock Classes="ribbon-command-label" Text="New" /></StackPanel>
                                    </Button>
                                    <Button Classes="ribbon-command" Width="82" Click="OpenProject_OnClick" ToolTip.Tip="Open an existing project" AutomationProperties.Name="Open project">
                                        <StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="▱" /><TextBlock Classes="ribbon-command-label" Text="Open project" /></StackPanel>
                                    </Button>
                                    <Button Classes="ribbon-command" Width="86" Click="OpenDrawing_OnClick" ToolTip.Tip="Open a drawing without its project" AutomationProperties.Name="Open drawing">
                                        <StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="▤" /><TextBlock Classes="ribbon-command-label" Text="Open drawing" /></StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Classes="ribbon-group-label" Text="PROJECT" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1" IsVisible="{Binding IsInsertRibbonTab}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="#303A43" BorderThickness="0,0,1,0" Padding="7,3,7,0">
                            <Grid RowDefinitions="*,18">
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                    <Button Classes="ribbon-command" Width="52" Command="{Binding SelectToolCommand}" CommandParameter="Line" ToolTip.Tip="Draw a line" AutomationProperties.Name="Line"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="╱" /><TextBlock Classes="ribbon-command-label" Text="Line" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="62" Command="{Binding SelectToolCommand}" CommandParameter="Polyline" ToolTip.Tip="Draw a polyline" AutomationProperties.Name="Polyline"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="⌁" /><TextBlock Classes="ribbon-command-label" Text="Polyline" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="52" Command="{Binding SelectToolCommand}" CommandParameter="Circle" ToolTip.Tip="Draw a circle" AutomationProperties.Name="Circle"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="○" /><TextBlock Classes="ribbon-command-label" Text="Circle" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="66" Command="{Binding SelectToolCommand}" CommandParameter="Rectangle" ToolTip.Tip="Draw a rectangle" AutomationProperties.Name="Rectangle"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="▭" /><TextBlock Classes="ribbon-command-label" Text="Rectangle" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="48" Command="{Binding SelectToolCommand}" CommandParameter="Text" ToolTip.Tip="Add text" AutomationProperties.Name="Text"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="T" /><TextBlock Classes="ribbon-command-label" Text="Text" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="68" Command="{Binding SelectToolCommand}" CommandParameter="Dimension" ToolTip.Tip="Add a dimension" AutomationProperties.Name="Dimension"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="↔" /><TextBlock Classes="ribbon-command-label" Text="Dimension" /></StackPanel></Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Classes="ribbon-group-label" Text="DRAW" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1" IsVisible="{Binding IsModifyRibbonTab}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="#303A43" BorderThickness="0,0,1,0" Padding="7,3,7,0">
                            <Grid RowDefinitions="*,18">
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                    <Button Classes="ribbon-command" Width="56" Command="{Binding SelectToolCommand}" CommandParameter="Select" ToolTip.Tip="Select entities" AutomationProperties.Name="Select"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="⌖" /><TextBlock Classes="ribbon-command-label" Text="Select" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="54" Command="{Binding SelectToolCommand}" CommandParameter="Move" ToolTip.Tip="Move selected entities" AutomationProperties.Name="Move"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="✥" /><TextBlock Classes="ribbon-command-label" Text="Move" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="54" Command="{Binding SelectToolCommand}" CommandParameter="Copy" ToolTip.Tip="Copy selected entities" AutomationProperties.Name="Copy"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="⧉" /><TextBlock Classes="ribbon-command-label" Text="Copy" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="56" Command="{Binding SelectToolCommand}" CommandParameter="Rotate" ToolTip.Tip="Rotate selected entities" AutomationProperties.Name="Rotate"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="↻" /><TextBlock Classes="ribbon-command-label" Text="Rotate" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="54" Command="{Binding SelectToolCommand}" CommandParameter="Scale" ToolTip.Tip="Scale selected entities" AutomationProperties.Name="Scale"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="⤢" /><TextBlock Classes="ribbon-command-label" Text="Scale" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="54" Command="{Binding EraseCommand}" ToolTip.Tip="{Binding EraseToolTip}" AutomationProperties.Name="Erase"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="⌫" /><TextBlock Classes="ribbon-command-label" Text="Erase" /></StackPanel></Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Classes="ribbon-group-label" Text="EDIT" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1" IsVisible="{Binding IsViewRibbonTab}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="#303A43" BorderThickness="0,0,1,0" Padding="7,3,7,0">
                            <Grid RowDefinitions="*,18">
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                    <Button Classes="ribbon-command" Width="72" Command="{Binding AddViewportModuleCommand}" CommandParameter="Viewer" IsEnabled="{Binding CanAddViewerModule}" ToolTip.Tip="Add the Viewer module" AutomationProperties.Name="Add Viewer module"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="▣" /><TextBlock Classes="ribbon-command-label" Text="Viewer" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="72" Command="{Binding AddViewportModuleCommand}" CommandParameter="Layers" IsEnabled="{Binding CanAddLayersModule}" ToolTip.Tip="Add the Layers module" AutomationProperties.Name="Add Layers module"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="☰" /><TextBlock Classes="ribbon-command-label" Text="Layers" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="82" Command="{Binding AddViewportModuleCommand}" CommandParameter="Properties" IsEnabled="{Binding CanAddPropertiesModule}" ToolTip.Tip="Add the Properties module" AutomationProperties.Name="Add Properties module"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="☷" /><TextBlock Classes="ribbon-command-label" Text="Properties" /></StackPanel></Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Classes="ribbon-group-label" Text="MODULES" />
                            </Grid>
                        </Border>
                        <Border BorderBrush="#303A43" BorderThickness="0,0,1,0" Padding="7,3,7,0">
                            <Grid RowDefinitions="*,18">
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                    <Button Classes="ribbon-command" Width="76" Command="{Binding ToggleGridCommand}" IsEnabled="{Binding IsWorkspaceVisible}" AutomationProperties.Name="Toggle grid"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="#" /><TextBlock Classes="ribbon-command-label" Text="{Binding GridStatus}" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="76" Command="{Binding ToggleOrthoCommand}" IsEnabled="{Binding IsWorkspaceVisible}" AutomationProperties.Name="Toggle orthographic tracking"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="└" /><TextBlock Classes="ribbon-command-label" Text="{Binding OrthoStatus}" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="76" Command="{Binding TogglePolarCommand}" IsEnabled="{Binding IsWorkspaceVisible}" AutomationProperties.Name="Toggle polar tracking"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="∠" /><TextBlock Classes="ribbon-command-label" Text="{Binding PolarStatus}" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="90" Command="{Binding ToggleSnapCommand}" IsEnabled="{Binding IsWorkspaceVisible}" AutomationProperties.Name="Toggle grid snap"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="⌗" /><TextBlock Classes="ribbon-command-label" Text="{Binding SnapStatus}" /></StackPanel></Button>
                                    <Button Classes="ribbon-command" Width="100" Command="{Binding ToggleObjectSnapCommand}" IsEnabled="{Binding IsWorkspaceVisible}" AutomationProperties.Name="Toggle object snap"><StackPanel Spacing="2"><TextBlock Classes="ribbon-icon" Text="◎" /><TextBlock Classes="ribbon-command-label" Text="{Binding ObjectSnapStatus}" /></StackPanel></Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Classes="ribbon-group-label" Text="DISPLAY" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Project/start tabs -->
        <Border Grid.Row="1" Background="#0D1216" BorderBrush="#263039" BorderThickness="0,0,0,1" Padding="9,5,9,0">
            <ListBox ItemsSource="{Binding ProjectTabs}" SelectedItem="{Binding SelectedProjectTab}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="12,6" /><Setter Property="CornerRadius" Value="5,5,0,0" /></Style>
                    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="#202A32" /></Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectTabViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            <Button Classes="tab-close"
                                    IsVisible="{Binding CanClose}"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseProjectTabCommand}"
                                    CommandParameter="{Binding .}"
                                    ToolTip.Tip="Save and close project"
                                    AutomationProperties.Name="Close project tab">
                                <Path Data="M3,3 L11,11 M11,3 L3,11"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      StrokeThickness="1.3"
                                      StrokeLineCap="Round"
                                      Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Drawing tabs -->
        <Border Grid.Row="2" Background="#151C22" BorderBrush="#2B353E" BorderThickness="0,0,0,1" Padding="13,4" IsVisible="{Binding IsWorkspaceVisible}">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="DRAWINGS" FontSize="10" FontWeight="SemiBold" Foreground="#71838F" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ListBox Grid.Column="1" ItemsSource="{Binding DrawingTabs}" SelectedItem="{Binding SelectedDrawingTab}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="13,6" /><Setter Property="CornerRadius" Value="4" /></Style></ListBox.Styles>
                    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:DrawingTabViewModel"><TextBlock Text="{Binding Title}" /></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Association safety warning -->
        <Border Grid.Row="3" IsVisible="{Binding HasWarning}" Background="#3B2B17" BorderBrush="#9F6B22" BorderThickness="0,0,0,1" Padding="14,9">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="⚠" Foreground="#F4B95E" FontSize="16" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding WarningMessage}" Foreground="#F5D7A5" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Dismiss" Command="{Binding DismissWarningCommand}" Background="Transparent" />
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="4">
            <Border IsVisible="{Binding IsWelcomeVisible}" Background="#0C1014">
                <Grid ColumnDefinitions="1.2*,1*" Margin="80,60">
                    <StackPanel VerticalAlignment="Center" MaxWidth="600" Spacing="18">
                        <TextBlock Text="DRAW WITH INTENT." FontSize="12" FontWeight="Bold" Foreground="#27A879" />
                        <TextBlock Text="A modern foundation for precise technical drawings." FontSize="42" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="48" />
                        <TextBlock Text="Projects keep layouts, drawings, references and revision history together. Individual drawings stay portable—with clear warnings when project context matters." Foreground="#9CACB7" FontSize="16" TextWrapping="Wrap" LineHeight="25" MaxWidth="560" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                            <Button Classes="primary" Content="Create a project" Click="NewProject_OnClick" />
                            <Button Content="Open existing project" Padding="18,10" Click="OpenProject_OnClick" />
                        </StackPanel>
                        <Border Height="1" Background="#29333B" Margin="0,8,0,0" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="22">
                            <StackPanel>
                                <TextBlock Text="RECENT PROJECTS" FontSize="10" FontWeight="Bold" Foreground="#7C909C" Margin="0,0,0,5" />
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasRecentProjects}">
                                    <ItemsControl ItemsSource="{Binding RecentProjects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="persistence:RecentFileEntry">
                                                <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenRecentProjectCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        Padding="7,5"
                                                        HorizontalContentAlignment="Stretch"
                                                        ToolTip.Tip="{Binding Path}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Location}" FontSize="10" Foreground="#71838F" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="RECENT DRAWINGS" FontSize="10" FontWeight="Bold" Foreground="#7C909C" Margin="0,0,0,5" />
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasRecentDrawings}">
                                    <ItemsControl ItemsSource="{Binding RecentDrawings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="persistence:RecentFileEntry">
                                                <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenRecentDrawingCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        Padding="7,5"
                                                        HorizontalContentAlignment="Stretch"
                                                        ToolTip.Tip="{Binding Path}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Location}" FontSize="10" Foreground="#71838F" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="No recent projects or drawings yet."
                                   IsVisible="{Binding HasNoRecentItems}"
                                   Foreground="#71838F"
                                   FontStyle="Italic" />
                        <TextBlock Text="Recents and preferences are saved between sessions."
                                   FontSize="10"
                                   Foreground="#5F727E"
                                   ToolTip.Tip="{Binding UserDataDirectory}" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="panel" CornerRadius="12" Margin="60,30,0,30" Padding="30">
                        <StackPanel Spacing="20">
                            <TextBlock Text="PROJECT WORKSPACE" FontSize="11" FontWeight="Bold" Foreground="#7C909C" />
                            <TextBlock Text="Everything a drawing needs, in one transparent folder." FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="16">
                                <TextBlock Text="01" Foreground="#27A879" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="Human-readable .dfproj and .dfdraw files" />
                                <TextBlock Grid.Row="1" Text="02" Foreground="#27A879" FontWeight="Bold" /><TextBlock Grid.Row="1" Grid.Column="1" Text="Per-layout grid, snap, zoom and display settings" />
                                <TextBlock Grid.Row="2" Text="03" Foreground="#27A879" FontWeight="Bold" /><TextBlock Grid.Row="2" Grid.Column="1" Text="Layer styling, visibility, locking and grouping" />
                                <TextBlock Grid.Row="3" Text="04" Foreground="#27A879" FontWeight="Bold" /><TextBlock Grid.Row="3" Grid.Column="1" Text="Automatic project and drawing history" />
                            </Grid>
                            <Border Height="1" Background="#2B353D" Margin="0,6" />
                            <TextBlock Text="EARLY FOUNDATION" Foreground="#F4B95E" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="The first milestone focuses on file integrity, workspace architecture, layers and an extensible 2D viewport." Foreground="#8FA1AD" TextWrapping="Wrap" LineHeight="21" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <controls:ViewportModuleHost x:Name="ViewportModulesHost"
                                         IsVisible="{Binding IsWorkspaceVisible}"
                                         ItemsSource="{Binding ViewportModules}" />
        </Grid>

        <!-- Command line and layout bar -->
        <Grid Grid.Row="5" RowDefinitions="Auto,Auto" IsVisible="{Binding IsWorkspaceVisible}">
            <Border Background="#0D1216" BorderBrush="#2B353E" BorderThickness="0,1,0,0" Padding="10,5">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="COMMAND" FontSize="9" FontWeight="Bold" Foreground="#67D6AD" VerticalAlignment="Center" />
                    <TextBox x:Name="CoordinateInput"
                             Grid.Column="1"
                             Text="{Binding CoordinateInputText}"
                             PlaceholderText="Coordinate: 100,50 · @25,-10 · @50&lt;30"
                             KeyDown="CoordinateInput_OnKeyDown"
                             Padding="8,4" />
                    <Button Grid.Column="2" Content="Enter" Click="CoordinateSubmit_OnClick" Padding="12,4" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="#11171C" BorderBrush="#2B353E" BorderThickness="0,1,0,0" Padding="10,5">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Button Content="＋" Command="{Binding AddLayoutCommand}" Padding="9,4" ToolTip.Tip="New layout" />
                        <ListBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="13,5" /><Setter Property="CornerRadius" Value="4" /></Style><Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="#276E59" /></Style></ListBox.Styles>
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ToolStatus}"
                               Foreground="#67D6AD"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="18,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="#81939E" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                        <Button Classes="tool" Content="{Binding GridStatus}" Command="{Binding ToggleGridCommand}" />
                        <Button Classes="tool" Content="{Binding OrthoStatus}" Command="{Binding ToggleOrthoCommand}" />
                        <Button Classes="tool" Content="{Binding PolarStatus}" Command="{Binding TogglePolarCommand}" />
                        <Button Classes="tool" Content="{Binding SnapStatus}" Command="{Binding ToggleSnapCommand}" />
                        <Button Classes="tool" Content="{Binding ObjectSnapStatus}" Command="{Binding ToggleObjectSnapCommand}" />
                        <Border Width="1" Background="#334049" Margin="7,1" />
                        <TextBlock Text="{Binding ZoomStatus}" Width="48" TextAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
