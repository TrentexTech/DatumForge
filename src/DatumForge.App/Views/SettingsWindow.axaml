<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DatumForge.App.ViewModels"
        x:Class="DatumForge.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="DatumForge settings"
        Width="920"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="SettingsWindow_OnKeyDown">
    <Grid RowDefinitions="96,*,76">
        <Border Background="#151B21" BorderBrush="#2B353D" BorderThickness="0,0,0,1" Padding="28,18">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="#F1F6F8" />
                <TextBlock Text="Application preferences, shortcuts and information" Foreground="#8FA8D8" />
            </StackPanel>
        </Border>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" TabStripPlacement="Left" Padding="0">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="Width" Value="220" />
                    <Setter Property="Height" Value="54" />
                    <Setter Property="Padding" Value="20,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="Foreground" Value="#CFD9DF" />
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Background" Value="#176398" />
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style Selector="TabItem:selected:pointerover">
                    <Setter Property="Background" Value="#176398" />
                    <Setter Property="Foreground" Value="White" />
                </Style>
            </TabControl.Styles>

            <TabItem Header="About">
                <ScrollViewer>
                    <StackPanel Margin="36,28" Spacing="20" MaxWidth="650" HorizontalAlignment="Center">
                        <Border Width="88" Height="88" CornerRadius="20" Background="#27A879" HorizontalAlignment="Center">
                            <TextBlock Text="D" FontSize="54" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="DatumForge" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="Open-source precision drawing workspace" Foreground="#8FA8D8" HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border Classes="panel" CornerRadius="7" Padding="20">
                            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                <TextBlock Text="Version" Foreground="#8FA8D8" />
                                <TextBlock Grid.Column="1" Text="{Binding Version}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Text="Executable" Foreground="#8FA8D8" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Executable}" />
                                <TextBlock Grid.Row="2" Text="Runtime" Foreground="#8FA8D8" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Runtime}" />
                                <TextBlock Grid.Row="3" Text="Local data" Foreground="#8FA8D8" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LocalData}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="4" Text="License" Foreground="#8FA8D8" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding License}" />
                            </Grid>
                        </Border>

                        <Border Background="#18241F" BorderBrush="#315A49" BorderThickness="1" CornerRadius="7" Padding="18">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Open source" FontSize="16" FontWeight="SemiBold" Foreground="#72D7B1" />
                                <TextBlock Text="DatumForge is independent community software. Its source code may be used, modified and distributed under the MIT License." TextWrapping="Wrap" Foreground="#B6C6CE" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Keybinds">
                <Grid Margin="32,24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Keyboard shortcuts" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Click an assignment, then press a new shortcut. Delete or Backspace clears it; Escape cancels capture."
                                   Foreground="#93A5AF" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="#3A231D" BorderBrush="#7A4337" BorderThickness="1" CornerRadius="5"
                            Padding="12,8" IsVisible="{Binding HasValidationMessage}">
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFB5A5" TextWrapping="Wrap" />
                    </Border>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Shortcuts}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShortcutItemViewModel">
                                <Grid ColumnDefinitions="90,*,180" Margin="0,3">
                                    <TextBlock Text="{Binding Category}" Foreground="#728691" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Content="{Binding DisplayGesture}"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,7"
                                            Click="Shortcut_OnClick"
                                            AutomationProperties.Name="{Binding Name}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="3" Content="Reset to defaults" HorizontalAlignment="Left" Click="ResetKeyBindings_OnClick" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#151B21" BorderBrush="#2B353D" BorderThickness="0,1,0,0" Padding="18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Cancel" Width="104" Click="Cancel_OnClick" IsCancel="True" />
                <Button Content="Save" Classes="primary" Width="104" Click="Save_OnClick" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
